     "x": 208,
     "y": 528,
     "point": true,
     "properties": [
      {
       "name": "texto",
       "type": "string",
       "value": "A cortina de gelo cai do mirante até o terraço de baixo. Daqui se vê a Serra Gelada inteira e, longe, o Morro do Sol."
      }
     ]
    },
