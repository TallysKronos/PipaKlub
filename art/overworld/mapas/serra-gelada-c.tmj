      {
       "name": "texto",
       "type": "string",
       "value": "Riscos fundos no gelo, em círculo. Algo grande anda em volta do topo, vigiando."
      }
     ]
    },
    {
     "id": 23205,
     "name": "Santuário da Coroa",
     "type": "interacao",
     "x": 1072,
     "y": 48,
     "point": true,
     "properties": [
      {
       "name": "texto",
       "type": "string",
       "value": "Uma pipa de gelo presa no altar, intacta. Diziam que só quem o Borealvo aceitasse poderia chegar até aqui."
      },
      {
       "name": "requer",
