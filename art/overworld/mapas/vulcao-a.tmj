  {
   "name": "eventos",
   "type": "objectgroup",
   "objects": [
    {
     "id": 22001,
     "name": "Chegada à caldeira",
     "type": "entrada",
     "x": 464,
     "y": 1680,
     "point": true,
     "properties": []
    },
    {
     "id": 22002,
     "name": "Celina",
     "type": "npc",
     "x": 560,
     "y": 1616,
     "point": true,
     "properties": [
      {
       "name": "district",
       "type": "string",
       "value": "morro"
      },
      {
       "name": "npcIdentity",
       "type": "string",
       "value": "celina"
      },
      {
       "name": "texto",
       "type": "string",
       "value": "Celina: Eu estudo o vulcão faz anos. A lava daqui não esfria: alguma coisa lá embaixo mantém ela acesa. O maciço a oeste é o caminho mais alto; a cratera fica do outro lado."
      },
      {
       "name": "bloqueia",
       "type": "bool",
       "value": false
      }
     ]
    },
    {
     "id": 22003,
     "name": "Marco de pedra",
     "type": "interacao",
     "x": 1008,
     "y": 1616,
     "point": true,
     "properties": [
      {
       "name": "texto",
       "type": "string",
       "value": "Uma pipa riscada no basalto, com a rabiola apontando para o alto. Alguém já soltou pipa no meio da lava."
      }
     ]
    },
    {
     "id": 22004,
     "name": "Garrafa no rochedo",
     "type": "interacao",
     "x": 1840,
     "y": 1648,
     "point": true,
     "properties": [
      {
       "name": "texto",
       "type": "string",
       "value": "Uma garrafa presa entre as pedras, com um bilhete: \"Se você chegou até aqui, olhe para cima. O caminho de verdade é pelo alto.\""
      }
     ]
    },
    {
     "id": 22005,
     "name": "Gruta do eco",
     "type": "interacao",
     "x": 176,
     "y": 1040,
     "point": true,
     "properties": [
      {
       "name": "texto",
       "type": "string",
       "value": "A parede devolve qualquer som três vezes. Alguém riscou nomes de pipas na pedra, um embaixo do outro."
      }
     ]
    },
    {
     "id": 22006,
     "name": "Borda da cratera",
     "type": "interacao",
     "x": 1424,
     "y": 848,
     "point": true,
     "properties": [
      {
       "name": "texto",
       "type": "string",
       "value": "O lago de lava borbulha devagar. O ar quente sobe em coluna: o vento perfeito para uma pipa, se ela não fosse de papel."
      }
     ]
    },
    {
     "id": 22007,
     "name": "Varanda da queda",
     "type": "interacao",
     "x": 784,
     "y": 784,
     "point": true,
     "properties": [
      {
       "name": "texto",
       "type": "string",
       "value": "Daqui se vê a lava do maciço despencar na fenda. O chão treme de leve, no ritmo da queda."
      }
     ]
    },
    {
     "id": 22008,
     "name": "Pico oeste",
     "type": "interacao",
     "x": 240,
     "y": 208,
     "point": true,
     "properties": [
      {
       "name": "texto",
       "type": "string",
       "value": "O ponto mais alto do maciço. Do outro lado da caldeira, a boca do vulcão solta uma coluna de calor."
      }
     ]
    },
    {
     "id": 22009,
     "name": "Boca do vulcão",
     "type": "interacao",
     "x": 1328,
     "y": 48,
     "point": true,
     "properties": [
      {
       "name": "texto",
       "type": "string",
       "value": "Daqui dá para ver Kronasta inteira: a Serra, o Porto, o Morro do Sol. No fundo da boca, a lava pulsa como um coração."
      }
     ]
    },
    {
     "id": 22010,
     "name": "Abrigo da crista",
     "type": "interacao",
     "x": 1872,
     "y": 464,
     "point": true,
