    {
     "id": 23104,
     "name": "Nilo",
     "type": "npc",
     "x": 1552,
     "y": 1200,
     "point": true,
     "properties": [
      {
       "name": "district",
       "type": "string",
       "value": "morro"
      },
      {
       "name": "npcIdentity",
       "type": "string",
       "value": "nilo"
      },
      {
       "name": "texto",
       "type": "string",
       "value": "Nilo: O desfiladeiro engana: o caminho sobe pelo leste e volta pelo alto. Lá embaixo, atrás da cortina de gelo, tem uma gruta que pouca gente conhece."
      },
      {
       "name": "bloqueia",
       "type": "bool",
       "value": false
      }
     ]
    },
    {
     "id": 23105,
     "name": "Gruta da Cascata",
     "type": "interacao",
     "x": 944,
     "y": 1072,
     "point": true,
     "properties": [
      {
       "name": "texto",
       "type": "string",
       "value": "Atrás da cascata congelada o gelo é azul-escuro e faz eco. No chão, marcas de pata maiores que um homem."
      }
     ]
    },
    {
     "id": 23106,
     "name": "Passarela",
     "type": "interacao",
     "x": 1296,
     "y": 560,
     "point": true,
     "properties": [
      {
       "name": "texto",
       "type": "string",
       "value": "Uma passarela de tábuas sobre o desfiladeiro. O vento assobia por baixo, num tom que lembra uma pipa cortando o ar."
      }
     ]
    },
    {
     "id": 23107,
     "name": "Acampamento abandonado",
     "type": "interacao",
     "x": 272,
     "y": 1200,
     "point": true,
     "properties": [
      {
       "name": "texto",
       "type": "string",
       "value": "Barracas rasgadas e um caderno com uma frase repetida: \"ele protege o topo; não suba sem estar pronto\"."
      }
     ]
    },
