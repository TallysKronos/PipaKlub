    },
    {
     "id": 23002,
     "name": "Voltar a Kronasta",
     "type": "saida",
     "x": 1360,
     "y": 1776,
     "point": true,
     "properties": [
      {
       "name": "destino",
       "type": "string",
       "value": "kronasta"
      }
     ]
    },
    {
     "id": 23003,
     "name": "Seguir pelo passo norte",
     "type": "saida",
     "x": 1584,
     "y": 16,
     "point": true,
     "properties": [
      {
       "name": "destino",
       "type": "string",
       "value": "serra-gelada-b"
      },
      {
       "name": "chegada_u",
       "type": "int",
       "value": 49
      },
      {
       "name": "chegada_v",
       "type": "int",
       "value": 52
      }
     ]
    },
    {
     "id": 23004,
     "name": "Celina",
     "type": "npc",
     "x": 1424,
     "y": 1520,
     "point": true,
     "properties": [
      {
       "name": "district",
       "type": "string",
       "value": "morro"
      },
      {
       "name": "npcIdentity",
       "type": "string",
       "value": "celina"
      },
      {
       "name": "texto",
       "type": "string",
       "value": "Celina: A Serra Gelada parece parada, mas a água corre por baixo do gelo. Siga o barulho da nascente: o passo norte fica lá em cima."
      },
      {
       "name": "bloqueia",
       "type": "bool",
       "value": false
      }
     ]
    },
    {
     "id": 23005,
     "name": "Lago congelado",
     "type": "interacao",
     "x": 496,
     "y": 1584,
     "point": true,
     "properties": [
      {
       "name": "texto",
       "type": "string",
       "value": "O gelo é grosso e firme. Por baixo, peixes prateados passam devagar, como pipas num céu escuro."
      }
     ]
    },
    {
     "id": 23006,
     "name": "Ponte da fenda",
     "type": "interacao",
     "x": 912,
     "y": 752,
     "point": true,
     "properties": [
      {
       "name": "texto",
       "type": "string",
       "value": "Tábuas amarradas com linha de pipa. Alguém da expedição confiou a travessia ao mesmo fio que solta as pipas."
      }
     ]
    },
    {
     "id": 23007,
     "name": "Pico oeste",
     "type": "interacao",
     "x": 208,
     "y": 496,
     "point": true,
     "properties": [
      {
       "name": "texto",
       "type": "string",
       "value": "Daqui se vê o vale inteiro. A cortina de gelo desce do pico como um véu parado no tempo."
      }
     ]
    },
    {
     "id": 23008,
     "name": "Nascente",
     "type": "interacao",
