extends RefCounted
## Wild encounter tables per Kronasta region (assets/campaign/encounters.json, generated by
## tools/criaturas/gerar-encontros.py from the approved distribution). "encontros" holds only
## species with battle art today; "planejado" names the catalog families each region gets
## once their art arrives.
const Pacing = preload("res://scripts/campaign/park_pacing.gd")
const PATH := "res://assets/campaign/encounters.json"
## Species valid in older saves, before the tables (encounters.gd and State up to 07/11).
const LEGACY := ["basica", "mata", "raio", "rascunho-bicho-pau", "rascunho-joaninha", "lacertubo"]
static var _data: Dictionary = {}

static func data() -> Dictionary:
	if _data.is_empty(): _data = JSON.parse_string(FileAccess.get_file_as_string(PATH))
	return _data

static func region_id(scene: String) -> String:
	for prefix: String in data().regioes:
		if scene.begins_with(prefix + "-"): return prefix
	return ""

static func table(scene: String) -> Array:
	var id := region_id(scene)
	return data().regioes[id].encontros if not id.is_empty() else data().padrao

static func planned(scene: String) -> Dictionary:
	var id := region_id(scene)
	return data().regioes[id].get("planejado", {}) if not id.is_empty() else {}

## roll in [0, 1). The very first wild encounter of a save is Carcará or Mata verde
## (the tutorial pair) wherever the region still uses the generic table.
static func choose(scene: String, roll: float, first: bool) -> String:
	var rows := table(scene)
	if first and rows == data().padrao:
		return "basica" if roll < .5 else "mata"
	var total := 0.0
	for row in rows: total += float(row.peso)
	var at := roll * total
	for row in rows:
		at -= float(row.peso)
		if at < 0: return str(row.modelo)
	return str(rows[-1].modelo)

static func level_band(scene: String) -> Vector2i:
	return Vector2i(Pacing.wild_level(scene, 0), Pacing.wild_level(scene, 2))

## Save validation for a wild encounter in a Kronasta scene: a species of the region's
## table (or one valid in older saves) at a level up to the region's top.
static func allows(scene: String, model_id: String, level: int) -> bool:
	var species := table(scene).map(func(row): return str(row.modelo))
	return (model_id in species or model_id in LEGACY) and level >= 1 and level <= level_band(scene).y
