extends SceneTree
const World = preload("res://scripts/overworld/veredas_modular_landscape.gd")
const Ground = preload("res://scripts/illustrated_ground.gd")
const Jump = preload("res://scripts/overworld/ledge_jump.gd")
var failures: Array[String] = []
func check(ok: bool, message: String) -> void:
	if not ok: failures.append(message)
func _initialize() -> void:
	var world := World.new()
	world.layout=JSON.parse_string(FileAccess.get_file_as_string("res://assets/overworld/kits/veredas-modular-v5/layout.json"))
	world.warp.setup(world.layout.anchors)
	for region: Dictionary in world.layout.raised:
		var r := region.duplicate(); r.points=world.polygon(r.points);world.raised.append(r)
		world.raised_outlines.append(r.points)
	var original: Dictionary=JSON.parse_string(FileAccess.get_file_as_string("res://assets/illustrated/routes-v2.json"))
	var ground := Ground.new(world.legacy_layout(original))
	for entry: Dictionary in world.jump_links():
		var jump := Jump.new()
		check(ground.walkable(entry.from,2),entry.id+": takeoff sole supported")
		check(ground.walkable(entry.to,2),entry.id+": landing sole supported")
		var upper := world.elevation(world.warp.transform(entry.from))
		var lower := world.elevation(world.warp.transform(entry.to))
		check(is_equal_approx(upper-lower,entry.drop),entry.id+": actual downward elevation")
		check(jump.begin(entry,entry.from,ground),entry.id+": begin valid jump")
		check(not jump.begin(entry,entry.from,ground),"no repeated jump while airborne")
		check(jump.screen_position(world.project).distance_to(world.project(entry.from))<.001,"exact starting support")
		jump.advance(Jump.PREPARE+Jump.FLIGHT*.5)
		var center: Vector2=world.project(entry.from).lerp(world.project(entry.to),.5)
		check(jump.screen_position(world.project).distance_to(center-Vector2(0,24))<.001,"apex independent of terrain discontinuity")
		check(jump.advance(10),"large delta lands once")
		check(not jump.advance(1),"landing event emitted once")
		check(jump.screen_position(world.project).distance_to(world.project(entry.to))<.001,"exact final support")
		check(jump.nearby(entry.to,[entry],ground).is_empty(),"lower edge cannot jump back upward")
		check(jump.nearby(entry.from+Vector2(100,100),[entry],ground).is_empty(),"distant point rejected")
		var invalid := entry.duplicate();invalid.to=Vector2(-5000,-5000)
		check(jump.nearby(entry.from,[invalid],ground).is_empty(),"unsupported landing rejected")
	world.free()
	for failure in failures: push_error(failure)
	print("Ledge jump: two measured drops, sole clearance, reverse/reentry rejection, exact endpoints and arc; failures=",failures.size())
	quit(0 if failures.is_empty() else 1)
